# ==============================================================================
# ChallanAI (EmbroideryOS) v3.0 - Backend Environment Variables
# Copy this file to .env and fill in your real credentials:
# cp .env.example .env
# ==============================================================================

# 1. Database Connection (Neon Serverless PostgreSQL or local SQLite fallback)
# Neon connection strings start with postgresql:// and connect via ep-*-pooler
DATABASE_URL=postgresql://user:password@ep-host-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Google Gemini API Key (Gemini 2.5 Flash for Image & PDF Challan OCR)
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_gemini_key_here

# 3. Multi-Tenant SaaS JWT Authentication Secret Key
# Generate a random 64-character secret for stateless HMAC-SHA256 tokens
JWT_SECRET_KEY=generate_a_64_char_secret_for_multi_tenant_saas_auth

# 4. Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
